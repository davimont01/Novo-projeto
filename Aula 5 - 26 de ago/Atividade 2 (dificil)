let nota2 = Number(prompt("Digite sua nota: (Atividade 12)"));
if (nota2 < 60) {
  console.log("F");
} else if (nota2 >= 60 && nota2 <= 69) {
  console.log("D");
} else if (nota2 >= 70 && nota2 <= 79) {
  console.log("C");
} else if (nota2 >= 80 && nota2 <= 89) {
  console.log("B");
} else {
  console.log("A");
}